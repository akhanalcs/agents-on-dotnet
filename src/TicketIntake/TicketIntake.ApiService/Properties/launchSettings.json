{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:5427",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        // Tells the SDK "this is a dev machine: only try developer sign-ins", so the managed-identity probe never happens
        "AZURE_TOKEN_CREDENTIALS": "dev"
      }
    },
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "https://localhost:7561;http://localhost:5427",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "AZURE_TOKEN_CREDENTIALS": "dev"
      }
    }
  }
}
